# Copy to .env and load it (or set these in your shell / deployment).

# --- Data source ---
DATA_PROVIDER=yahoo            # yahoo (free, ~15-min delayed) or eodhd (real-time/paid)
# EODHD_API_KEY=your_key_here

# --- Storage ---
# PORTFOLIO_DB=/data/portfolio.db   # point at a persistent volume in production

# --- App lock (optional) ---
# APP_PASSWORD=change-me

# --- AI news summary (optional; also: pip install anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Alert delivery (optional; used by alert_runner.py) ---
# NTFY_TOPIC=oslo-desk-pick-something-random     # free push via ntfy.sh
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# ALERT_EMAIL_FROM=you@example.com
# ALERT_EMAIL_TO=you@example.com
